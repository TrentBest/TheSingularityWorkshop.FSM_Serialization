<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>TheSingularityWorkshop.FSM_Serialization</PackageId>
    <Version>1.0.1</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Explicit byte-oriented serialization contracts and stream adapters for domain-owned binary representations.</Description>
    <PackageTags>serialization;binary;stream;FSM;TheSingularityWorkshop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.FSM_Serialization</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.FSM_Serialization</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TheSingularityWorkshop.FSM_Serialization.Tests\**" />
    <None Remove="TheSingularityWorkshop.FSM_Serialization.Tests\**" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="Gallery.md" Pack="true" PackagePath="" />
    <None Include="docs\**\*.md" Exclude="docs\SITH_BRANCH_RECONCILIATION.md" Pack="true" PackagePath="%(Identity)" />
    <None Include="src\**\*.md" Pack="true" PackagePath="%(Identity)" />
    <None Include="docs\images\**\*" Pack="true" PackagePath="docs\images\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="docs\images\" />
  </ItemGroup>

</Project>
